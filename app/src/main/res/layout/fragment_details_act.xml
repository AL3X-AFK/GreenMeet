<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:tools="http://schemas.android.com/tools"
    android:background="@color/white"
    tools:context=".fragments.DetailsActFragment">

        <!-- Imagen superior -->
        <ImageView
            android:id="@+id/imgHeader"
            android:layout_width="match_parent"
            android:layout_height="230dp"
            android:scaleType="centerInside"
            android:src="@drawable/placeholder"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <!-- Boton atras -->
        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/circle_bg_back"
            android:src="@drawable/arrow_back_icon"
            app:tint="@color/black"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            android:layout_margin="16dp"
            android:clickable="true"/>
        <!-- Card blanca -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardContent"
            android:layout_width="match_parent"
            android:layout_height="480dp"
            android:backgroundTint="@color/white"
            app:layout_constraintTop_toBottomOf="@id/imgHeader"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            >
            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="480dp"
                android:padding="10dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- Título -->
                    <TextView
                        android:id="@+id/tvTitulo"
                        android:text="Titulo"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        android:textColor="@android:color/black"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                    <!-- Categoría -->
                    <TextView
                        android:id="@+id/tvCategory"
                        android:text="@string/categoria"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="@color/darkgreen"
                        android:layout_marginTop="4dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>

                    <!-- Ubicación -->
                    <TextView
                        android:id="@+id/tvUbicacion"
                        android:text="📍 Guadalajara, Madrid"
                        android:textSize="14sp"
                        android:textColor="@color/gray"
                        android:layout_marginTop="4dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                    <!-- Horario -->
                    <TextView
                        android:layout_marginTop="20dp"
                        android:text="@string/fecha"
                        android:textStyle="bold"
                        android:textSize="16sp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>

                    <TextView
                        android:id="@+id/tvFecha"
                        android:text="Fecha"
                        android:textSize="14sp"
                        android:textColor="#444"
                        android:layout_marginTop="4dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>

                    <!-- Descripción -->
                    <TextView
                        android:id="@+id/tvDescripcion"
                        android:layout_marginTop="12dp"
                        android:textSize="14sp"
                        android:textColor="@color/black"
                        android:text="Nos reunimos para pintar un mural colectivo en un espacio autorizado del barrio.Una actividad creativa y abierta para mejorar el entorno, expresarnos y compartir tiempo juntos."
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"/>



